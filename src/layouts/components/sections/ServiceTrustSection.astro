---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Icons from "@/helpers/Icons.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { serviceTrustSectionSchema } from "@/sections.schema";

type ServiceTrustContent = Section &
  NonNullable<z.infer<typeof serviceTrustSectionSchema>>;

type Props = {
  content?: ServiceTrustContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "hvac-installation-trust-section",
    Astro.currentLocale,
  )
)?.data as ServiceTrustContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as ServiceTrustContent;

const {
  enable = true,
  eyebrow,
  title,
  description,
  items = [],
} = actualContent;

if (!enable || !items.length) {
  return null;
}
---

<section
  aria-labelledby="service-trust-heading"
  class="section-spacing-vertical overflow-hidden">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-20">
      <div class="lg:col-span-5" data-scroll-reveal="blur-up">
        {
          eyebrow && (
            <p
              class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base"
              set:html={markdownify(eyebrow)}
            />
          )
        }
        {
          title && (
            <h2
              id="service-trust-heading"
              class="mt-3"
              set:html={markdownify(title)}
            />
          )
        }
        {
          description && (
            <p
              class="text-text-default leading-body mt-6"
              set:html={markdownify(description)}
            />
          )
        }
      </div>

      <div
        class="border-border-light grid border-s border-t sm:grid-cols-2 lg:col-span-7"
        data-scroll-reveal="fade-up"
        data-scroll-reveal-delay="120">
        {
          items.map((item) => (
            <article class="border-border-light border-e border-b p-6 md:p-8">
              {item.icon && (
                <span class="bg-primary/10 text-primary flex size-11 items-center justify-center rounded-md">
                  <Icons icon={item.icon} class="size-5" stroke-width="1.8" />
                </span>
              )}
              <h3 class="text-h5 mt-6" set:html={markdownify(item.title)} />
              <p
                class="text-text-default leading-body mt-3"
                set:html={markdownify(item.description)}
              />
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
