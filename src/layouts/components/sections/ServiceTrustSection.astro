---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Icons from "@/helpers/Icons.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { serviceTrustSectionSchema } from "@/sections.schema";

type ServiceTrustContent = Section &
  NonNullable<z.infer<typeof serviceTrustSectionSchema>>;

type Props = {
  content?: ServiceTrustContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "hvac-installation-trust-section",
    Astro.currentLocale,
  )
)?.data as ServiceTrustContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as ServiceTrustContent;

const {
  enable = true,
  eyebrow,
  title,
  description,
  location,
  items = [],
} = actualContent;

if (!enable || !items.length) {
  return null;
}
---

<section aria-labelledby="service-trust-heading" class="overflow-hidden">
  <div class="container">
    <div
      class="border-border-light grid overflow-hidden border lg:grid-cols-12">
      <div
        class="bg-primary relative overflow-hidden px-7 py-10 md:px-10 md:py-12 lg:col-span-5 lg:flex lg:flex-col lg:justify-center lg:px-12"
        data-scroll-reveal="blur-up">
        <Icons
          icon="ShieldCheck"
          class="pointer-events-none absolute -right-10 -bottom-12 size-52 text-white/10"
          stroke-width="1"
          aria-hidden="true"
        />
        {
          eyebrow && (
            <p
              class="text-base-sm relative z-10 font-semibold tracking-widest text-white/80 uppercase md:text-base"
              set:html={markdownify(eyebrow)}
            />
          )
        }
        {
          title && (
            <h2
              id="service-trust-heading"
              class="relative z-10 mt-3 text-white"
              set:html={markdownify(title)}
            />
          )
        }
        {
          description && (
            <p
              class="leading-body relative z-10 mt-6 max-w-xl text-white/80"
              set:html={markdownify(description)}
            />
          )
        }
        {
          location && (
            <div class="relative z-10 mt-10 flex items-center gap-3 border-t border-white/20 pt-5 text-white">
              <Icons
                icon="MapPin"
                class="size-5 shrink-0"
                stroke-width="1.8"
                aria-hidden="true"
              />
              <p
                class="text-sm font-semibold tracking-widest uppercase"
                set:html={markdownify(location)}
              />
            </div>
          )
        }
      </div>

      <div
        class="bg-body px-7 py-4 md:px-10 lg:col-span-7 lg:px-12 lg:py-6"
        data-scroll-reveal="fade-up"
        data-scroll-reveal-delay="120">
        {
          items.map((item, index) => (
            <article
              class:list={[
                "grid grid-cols-12 gap-5 py-6 md:gap-7 md:py-7",
                index < items.length - 1 && "border-border-light border-b",
              ]}>
              <div class="col-span-2 pt-1">
                {item.icon && (
                  <Icons
                    icon={item.icon}
                    class="text-primary size-9 md:size-10"
                    stroke-width="1.6"
                    aria-hidden="true"
                  />
                )}
              </div>
              <div class="col-span-10">
                <h3 class="text-h5" set:html={markdownify(item.title)} />
                <p
                  class="text-text-default leading-body mt-3"
                  set:html={markdownify(item.description)}
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
