---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Button from "@/components/Button.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { alternativeServicesSectionSchema } from "@/sections.schema";

type AlternativeServicesContent = Section &
  NonNullable<z.infer<typeof alternativeServicesSectionSchema>>;

type Props = {
  content?: AlternativeServicesContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "alternative-services-section",
    Astro.currentLocale,
  )
)?.data as AlternativeServicesContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as AlternativeServicesContent;

const { enable = true, services = [] } = actualContent;

if (!enable || services.length === 0) {
  return null;
}
---

<section
  aria-label="Alternative Services"
  class="bg-theme-light overflow-visible pb-16 lg:pb-20 xl:pb-24">
  <div class="container min-w-0">
    <div class="grid min-w-0 grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="alternative-service-card group border-border-light flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border bg-white p-4 sm:p-5 lg:p-6">
            <OptimizedImage
              src={service.image}
              alt={service.imageAlt}
              width={720}
              height={480}
              widths={[540, 720, 900]}
              sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              class="aspect-3/2 w-full rounded-xl object-cover"
            />

            <div class="flex flex-1 flex-col px-1 pt-7 pb-1">
              <h2 class="text-h6">{service.title}</h2>
              <p class="mt-2">{service.description}</p>

              <div class="mt-auto pt-7">
                <Button {...service.button} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .alternative-service-card {
    box-shadow:
      0 2px 6px color-mix(in srgb, var(--color-dark) 12%, transparent),
      0 0 20px color-mix(in srgb, var(--color-dark) 13%, transparent),
      0 14px 30px -10px color-mix(in srgb, var(--color-dark) 24%, transparent);
    transform: translateY(0);
    transition:
      box-shadow 300ms ease-out,
      transform 300ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .alternative-service-card:hover {
      box-shadow:
        0 3px 8px color-mix(in srgb, var(--color-dark) 15%, transparent),
        0 0 28px color-mix(in srgb, var(--color-dark) 17%, transparent),
        0 18px 36px -10px color-mix(in srgb, var(--color-dark) 28%, transparent);
      transform: translateY(-3px);
    }
  }
</style>
