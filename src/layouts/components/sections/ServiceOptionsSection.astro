---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Button from "@/components/Button.astro";
import Icons from "@/helpers/Icons.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { serviceOptionsSectionSchema } from "@/sections.schema";

type ServiceOptionsContent = Section &
  NonNullable<z.infer<typeof serviceOptionsSectionSchema>>;

type Props = {
  content?: ServiceOptionsContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "hvac-installation-options-section",
    Astro.currentLocale,
  )
)?.data as ServiceOptionsContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as ServiceOptionsContent;

const {
  enable = true,
  eyebrow,
  title,
  description,
  items = [],
  button,
} = actualContent;

if (!enable || !items.length) {
  return null;
}
---

<section
  aria-labelledby="service-options-heading"
  class="section-spacing-vertical bg-theme-light overflow-hidden">
  <div class="container">
    <div class="grid items-end gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7" data-scroll-reveal="blur-up">
        {
          eyebrow && (
            <div class="flex items-center gap-3">
              <span
                class="bg-heat-accent h-1 w-8 rounded-full"
                aria-hidden="true"
              />
              <p
                class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base"
                set:html={markdownify(eyebrow)}
              />
            </div>
          )
        }
        {
          title && (
            <h2
              id="service-options-heading"
              class="mt-3 max-w-3xl"
              set:html={markdownify(title)}
            />
          )
        }
      </div>

      {
        description && (
          <p
            class="text-text-default leading-body max-w-xl lg:col-span-5 lg:justify-self-end"
            data-scroll-reveal="fade-up"
            data-scroll-reveal-delay="100"
            set:html={markdownify(description)}
          />
        )
      }
    </div>

    <div
      class="service-selector mt-10 grid min-w-0 gap-x-12 md:mt-12 lg:grid-cols-12 xl:gap-x-16"
      data-service-selector
      data-scroll-reveal="fade-up"
      data-scroll-reveal-delay="160">
      <div class="order-1 min-w-0 lg:col-span-7 lg:col-start-6">
        <div
          class="border-border-light flex min-w-0 gap-7 overflow-x-auto border-b md:gap-10"
          role="tablist"
          aria-label="HVAC system options"
          aria-orientation="horizontal">
          {
            items.map((item, index) => (
              <button
                id={`service-option-tab-${index}`}
                class="service-tab text-text-default focus-visible:outline-primary relative shrink-0 pb-4 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 md:text-base"
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`service-option-panel-${index}`}
                tabindex={index === 0 ? 0 : -1}
                data-service-tab>
                {item.tabLabel || item.title}
                <span
                  class="service-tab-indicator bg-heat-accent absolute bottom-0 left-0 h-1 w-0 transition-all duration-300"
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>
      </div>

      <div
        class="relative order-2 mt-7 min-h-80 lg:col-span-5 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:min-h-96">
        {
          items.map((item, index) => (
            <div
              class="border-primary/15 bg-primary-soft relative flex h-full min-h-80 flex-col justify-between overflow-hidden rounded-2xl border p-7 md:p-10 lg:min-h-96"
              data-service-visual={String(index)}
              hidden={index !== 0}>
              <div class="border-primary/10 pointer-events-none absolute top-16 -right-16 size-72 rounded-full border" />
              <div class="border-primary/10 pointer-events-none absolute top-24 -right-8 size-52 rounded-full border" />
              <div class="bg-primary/15 pointer-events-none absolute bottom-10 left-10 h-px w-40" />

              <div class="relative z-10 flex items-center gap-3">
                <span
                  class="bg-heat-accent size-3 rounded-full"
                  aria-hidden="true"
                />
                <span class="text-dark text-sm font-semibold tracking-widest uppercase">
                  System {item.number || String(index + 1).padStart(2, "0")}
                </span>
              </div>

              <div class="relative z-10 flex flex-1 items-center justify-center py-8">
                {item.icon && (
                  <Icons
                    icon={item.icon}
                    class="text-primary size-32 md:size-40"
                    stroke-width="1.05"
                    aria-hidden="true"
                  />
                )}
              </div>

              <div class="relative z-10">
                <p class="text-primary text-sm font-semibold tracking-widest uppercase">
                  Selected system
                </p>
                <p class="text-dark mt-2 text-xl font-semibold md:text-2xl">
                  {item.tabLabel || item.title}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="order-3 mt-8 min-w-0 lg:col-span-7 lg:col-start-6 lg:row-start-2">
        {
          items.map((item, index) => (
            <article
              id={`service-option-panel-${index}`}
              class="service-option-panel"
              role="tabpanel"
              tabindex="0"
              aria-labelledby={`service-option-tab-${index}`}
              data-service-panel>
              <h3
                class="text-h4-sm md:text-h4"
                set:html={markdownify(item.title)}
              />
              {item.tagline && (
                <p
                  class="text-dark mt-3 text-lg font-semibold"
                  set:html={markdownify(item.tagline)}
                />
              )}
              <p
                class="text-text-default leading-body mt-4 max-w-2xl"
                set:html={markdownify(item.description)}
              />

              {item.bestFor && (
                <div class="border-heat-accent mt-6 border-s-4 ps-4">
                  <p class="text-primary text-sm font-semibold tracking-widest uppercase">
                    Best For
                  </p>
                  <p
                    class="text-dark mt-1 font-semibold"
                    set:html={markdownify(item.bestFor)}
                  />
                </div>
              )}

              {item.highlights && item.highlights.length > 0 && (
                <ul class="mt-7 grid gap-3 sm:grid-cols-2" role="list">
                  {item.highlights.map((highlight) => (
                    <li class="text-dark flex items-start gap-3 font-medium">
                      <Icons
                        icon="Check"
                        class="text-heat-accent mt-1 size-5 shrink-0"
                        stroke-width="2.4"
                        aria-hidden="true"
                      />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}

              {button && (
                <div class="mt-8 w-fit">
                  <Button {...button} />
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const initializeServiceSelectors = () => {
    document
      .querySelectorAll<HTMLElement>("[data-service-selector]")
      .forEach((selector) => {
        if (selector.dataset.initialized === "true") return;

        const tabs = Array.from(
          selector.querySelectorAll<HTMLButtonElement>("[data-service-tab]"),
        );
        const panels = Array.from(
          selector.querySelectorAll<HTMLElement>("[data-service-panel]"),
        );
        const visuals = Array.from(
          selector.querySelectorAll<HTMLElement>("[data-service-visual]"),
        );
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const activateTab = (
          nextTab: HTMLButtonElement,
          shouldFocus = true,
        ) => {
          const panelId = nextTab.getAttribute("aria-controls");
          const activeIndex = tabs.indexOf(nextTab);

          tabs.forEach((tab) => {
            const isActive = tab === nextTab;
            tab.setAttribute("aria-selected", String(isActive));
            tab.tabIndex = isActive ? 0 : -1;
          });

          panels.forEach((panel) => {
            panel.hidden = panel.id !== panelId;
          });
          visuals.forEach((visual) => {
            visual.hidden =
              visual.dataset.serviceVisual !== String(activeIndex);
          });

          const activePanel = panels.find((panel) => panel.id === panelId);
          const activeVisual = visuals.find(
            (visual) => visual.dataset.serviceVisual === String(activeIndex),
          );

          if (!reduceMotion) {
            activePanel?.animate(
              [
                { opacity: 0.35, transform: "translateY(8px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 220, easing: "ease-out" },
            );
            activeVisual?.animate(
              [
                { opacity: 0.45, transform: "translateY(6px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 240, easing: "ease-out" },
            );
          }

          if (shouldFocus) {
            nextTab.focus();
            nextTab.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "nearest",
            });
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => activateTab(tab, false));
          tab.addEventListener("keydown", (event) => {
            const currentIndex = tabs.indexOf(tab);
            let nextIndex = currentIndex;

            if (event.key === "ArrowRight") {
              nextIndex = (currentIndex + 1) % tabs.length;
            } else if (event.key === "ArrowLeft") {
              nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            } else if (event.key === "Home") {
              nextIndex = 0;
            } else if (event.key === "End") {
              nextIndex = tabs.length - 1;
            } else {
              return;
            }

            event.preventDefault();
            activateTab(tabs[nextIndex]);
          });
        });

        const initialTab =
          tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ||
          tabs[0];
        if (initialTab) activateTab(initialTab, false);

        selector.dataset.initialized = "true";
        selector.dataset.tabsReady = "true";
      });
  };

  initializeServiceSelectors();
  document.addEventListener("astro:page-load", initializeServiceSelectors);
</script>

<style>
  .service-tab[aria-selected="true"] {
    color: var(--color-dark);
  }

  .service-tab[aria-selected="true"] .service-tab-indicator {
    width: 100%;
  }
</style>
