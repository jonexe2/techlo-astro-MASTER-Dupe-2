---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import Icons from "@/helpers/Icons.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { serviceBenefitsSectionSchema } from "@/sections.schema";

type ServiceBenefitsContent = Section &
  NonNullable<z.infer<typeof serviceBenefitsSectionSchema>>;

type Props = {
  content?: ServiceBenefitsContent;
};

const defaultContent = (
  await getEntryCTM(
    "sections",
    "hvac-installation-benefits-section",
    Astro.currentLocale,
  )
)?.data as ServiceBenefitsContent;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content || {},
) as ServiceBenefitsContent;

const { enable = true, title, description, items = [] } = actualContent;

if (!enable || !items.length) {
  return null;
}
---

<section
  aria-labelledby="service-benefits-heading"
  class="section-spacing-vertical overflow-hidden">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-20">
      <div class="lg:col-span-5" data-scroll-reveal="blur-up">
        {
          title && (
            <h2 id="service-benefits-heading" set:html={markdownify(title)} />
          )
        }
        {
          description && (
            <p
              class="text-text-default leading-body mt-6 max-w-xl"
              set:html={markdownify(description)}
            />
          )
        }
      </div>

      <div class="border-border-light border-t lg:col-span-7">
        {
          items.map((item, index) => (
            <article
              class="border-border-light grid grid-cols-12 gap-5 border-b py-7 md:gap-7 md:py-8"
              data-scroll-reveal="fade-up"
              data-scroll-reveal-delay={index * 100}>
              <div class="col-span-2 pt-1">
                <span class="bg-primary/10 text-primary flex size-10 items-center justify-center rounded-md">
                  {item.icon ? (
                    <Icons icon={item.icon} class="size-5" stroke-width="1.8" />
                  ) : (
                    <span class="text-sm font-semibold">
                      {item.number || String(index + 1).padStart(2, "0")}
                    </span>
                  )}
                </span>
              </div>
              <div class="col-span-10">
                <h3 class="text-h5" set:html={markdownify(item.title)} />
                <p
                  class="text-text-default leading-body mt-3"
                  set:html={markdownify(item.description)}
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
