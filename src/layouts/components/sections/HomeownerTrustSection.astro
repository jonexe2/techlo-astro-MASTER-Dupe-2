---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import type { homeownerTrustSectionSchema } from "@/sections.schema";
import { markdownify } from "@/lib/utils/textConverter";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import Icons from "@/helpers/Icons.astro";

type HomeownerTrustContent = Section &
  NonNullable<z.infer<typeof homeownerTrustSectionSchema>>;

type Props = {
  content?: HomeownerTrustContent;
};

const {
  enable = true,
  eyebrow,
  title,
  description,
  images = { large: "", small: "" },
  features = [],
} = (Astro.props.content || {}) as HomeownerTrustContent;

if (!enable || !title || features.length !== 4) {
  return null;
}
---

<section class="bg-theme-light section-spacing-vertical overflow-hidden">
  <div class="container">
    <header class="mx-auto mb-14 max-w-4xl text-center lg:mb-16">
      {
        eyebrow && (
          <div
            class="flex items-center justify-center gap-3"
            data-scroll-reveal="fade-up">
            <span
              class="bg-heat-accent h-1 w-8 rounded-full"
              aria-hidden="true"
            />
            <p
              class="text-primary text-base-sm font-semibold tracking-widest uppercase md:text-base"
              set:html={markdownify(eyebrow)}
            />
          </div>
        )
      }
      <h2
        class:list={[eyebrow && "mt-4"]}
        data-scroll-reveal="blur-up"
        set:html={markdownify(title)}
      />
      {
        description && (
          <p
            class="text-text-default leading-body mx-auto mt-5 max-w-2xl"
            data-scroll-reveal="fade-up"
            data-scroll-reveal-delay="100"
            set:html={markdownify(description)}
          />
        )
      }
    </header>

    <div class="grid place-items-center gap-16 lg:grid-cols-2 xl:gap-24">
      <div
        class="relative isolate z-0"
        data-scroll-reveal="image-clip">
        <svg class="absolute h-0 w-0" aria-hidden="true">
          <clipPath
            id="about-clip-path-1-x"
            clipPathUnits="objectBoundingBox">
            <path
              d="M1,0.828 C1,0.845, 0.993,0.861, 0.981,0.872 L0.87,0.982 C0.858,0.993, 0.842,1, 0.825,1 H0.064 C0.029,1, 0,0.972, 0,0.938 V0.172 C0,0.155, 0.007,0.139, 0.019,0.128 L0.13,0.018 C0.142,0.007, 0.158,0, 0.175,0 H0.936 C0.971,0, 1,0.028, 1,0.063 V0.828 Z">
            </path>
          </clipPath>
        </svg>

        {
          images.large && (
            <div class="relative mr-auto h-125 w-4/5 rounded-4xl pb-14 sm:h-142">
              <div class="clip-about-shape h-full w-full">
                <OptimizedImage
                  width={900}
                  src={images.large}
                  class="h-full w-full object-cover"
                />
              </div>

              <OptimizedImage
                class="pointer-events-none absolute top-20 -right-20 -z-10 rotate-180 select-none"
                src="/images/banner-dots-dark.svg"
              />
              <OptimizedImage
                class="pointer-events-none absolute top-36 -right-10 -z-10 select-none"
                src="/images/banner-dots-dark.svg"
              />
            </div>
          )
        }

        {
          images.small && (
            <>
              <div class="clip-about-shape absolute right-0 bottom-0 h-1/2 w-7/12 scale-105 bg-white sm:bottom-0 sm:w-5/12" />
              <div class="absolute right-0 bottom-0 h-1/2 w-7/12 rounded-4xl sm:w-5/12">
                <div class="clip-about-shape h-full w-full">
                  <OptimizedImage
                    width={300}
                    src={images.small}
                    class="h-full w-full object-cover"
                  />
                </div>

                <OptimizedImage
                  class="pointer-events-none absolute bottom-0 -left-20 -z-10 select-none"
                  src="/images/banner-dots-dark.svg"
                />
              </div>
            </>
          )
        }

        <OptimizedImage
          src="/images/banner-dots.svg"
          class="absolute -top-10 -left-10 -z-10 opacity-20"
        />
      </div>

      <div
        class="border-border-light w-full overflow-hidden rounded-xl border bg-white"
        data-scroll-reveal="fade-up"
        data-scroll-reveal-delay="120">
        <div class="divide-border-light divide-y">
          {
            features.map((feature) => (
              <article class="flex items-center px-5 py-6 sm:px-6 lg:px-8 lg:py-8">
                <Icons
                  icon={feature.icon}
            class="text-primary size-9 shrink-0"
                  stroke-width="1.6"
                  aria-hidden="true"
                />
                <div class="ml-5 min-w-0 flex-1 sm:ml-6 lg:ml-7">
                  <h3
                    class="text-h6-sm md:text-h6 text-dark"
                    set:html={markdownify(feature.title)}
                  />
                  <p
                    class="text-text-default leading-body mt-1.5 text-sm sm:text-base"
                    set:html={markdownify(feature.description)}
                  />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
