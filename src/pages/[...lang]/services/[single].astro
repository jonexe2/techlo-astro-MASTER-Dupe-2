---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import ServicesSingle from "@/components/ServicesSingle.astro";
import extractSlug from "@/lib/utils/extractSlug";
import config from ".astro/config.generated.json";
import PageHeader from "@/components/widgets/PageHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import ServiceAreaSection from "@/components/sections/ServiceAreaSection.astro";
import WorkingProcessSection from "@/components/sections/WorkingProcessSection.astro";
import ServiceEmergencyCtaSection from "@/components/sections/ServiceEmergencyCtaSection.astro";
import ServiceOptionsSection from "@/components/sections/ServiceOptionsSection.astro";
import ServiceBenefitsSection from "@/components/sections/ServiceBenefitsSection.astro";
import ServiceTrustSection from "@/components/sections/ServiceTrustSection.astro";
import TestimonialQuoteSection from "@/components/sections/TestimonialQuoteSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { servicesFolder } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const serviceIndex = await getEntryCTM(
        servicesFolder as "services",
        "-index",
        lang.languageCode,
      );

      let services = await getCollectionCTM(
        servicesFolder as "services",
        lang.languageCode,
      );

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (serviceIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return services.map((service) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single: extractSlug(service).split("/").pop(),
        },
        props: {
          service,
          serviceIndex,
        },
      }));
    }),
  );

  return paths.flat();
}

const { service } = Astro.props;

const serviceSlug = extractSlug(service).split("/").pop();
const isHeatingRepairService = serviceSlug === "service-02";
const isHvacInstallationService = serviceSlug === "service-03";

const serviceDetailFaqContent = await getEntryCTM(
  "sections",
  "service-detail-faq-section",
  Astro.currentLocale,
);

const heatingRepairFaqContent = await getEntryCTM(
  "sections",
  "heating-repair-faq-section",
  Astro.currentLocale,
);

const hvacInstallationFaqContent = await getEntryCTM(
  "sections",
  "hvac-installation-faq-section",
  Astro.currentLocale,
);

const hvacInstallationProcessContent = await getEntryCTM(
  "sections",
  "hvac-installation-process-section",
  Astro.currentLocale,
);

const hvacInstallationFinalCtaContent = await getEntryCTM(
  "sections",
  "hvac-installation-final-cta",
  Astro.currentLocale,
);

const heatingRepairOptionsContent = await getEntryCTM(
  "sections",
  "heating-repair-options-section",
  Astro.currentLocale,
);

const heatingRepairBenefitsContent = await getEntryCTM(
  "sections",
  "heating-repair-benefits-section",
  Astro.currentLocale,
);

const heatingRepairProcessContent = await getEntryCTM(
  "sections",
  "heating-repair-process-section",
  Astro.currentLocale,
);

const heatingRepairTrustContent = await getEntryCTM(
  "sections",
  "heating-repair-trust-section",
  Astro.currentLocale,
);

const heatingRepairFinalCtaContent = await getEntryCTM(
  "sections",
  "heating-repair-final-cta",
  Astro.currentLocale,
);

const activeFaqContent = isHeatingRepairService
  ? heatingRepairFaqContent
  : isHvacInstallationService
    ? hvacInstallationFaqContent
    : serviceDetailFaqContent;

const hvacSidebarCtaContent = {
  icon: "Headset",
  title: "Planning a New HVAC System?",
  description:
    "Talk with BlueFlame Heating & Air about installation options designed around your home, comfort needs, and budget.",
  button: {
    enable: true,
    label: "Request an Estimate",
    url: "/#contact",
    hoverEffect: "magnetic-text-flip",
    variant: "fill",
  },
} as const;
---

<Base
  {...service.data}
  fitToScreen={false}
  hideCallToAction={isHeatingRepairService || isHvacInstallationService}>
  <PageHeader content={service?.data} />
  <ServicesSingle
    content={service}
    sidebarCtaContent={isHvacInstallationService
      ? hvacSidebarCtaContent
      : undefined}
  />
  {isHeatingRepairService && <ServiceEmergencyCtaSection />}
  {
    isHeatingRepairService && (
      <ServiceOptionsSection content={heatingRepairOptionsContent?.data} />
    )
  }
  {
    isHeatingRepairService && (
      <ServiceBenefitsSection content={heatingRepairBenefitsContent?.data} />
    )
  }
  {
    isHeatingRepairService && (
      <WorkingProcessSection
        content={heatingRepairProcessContent?.data}
        hasLightBackground
      />
    )
  }
  {
    isHeatingRepairService && (
      <ServiceTrustSection content={heatingRepairTrustContent?.data} />
    )
  }
  {
    isHeatingRepairService && (
      <TestimonialQuoteSection hasSectionSpacing={false} />
    )
  }
  {isHvacInstallationService && <ServiceOptionsSection />}
  {isHvacInstallationService && <ServiceBenefitsSection />}
  {
    isHvacInstallationService && (
      <WorkingProcessSection
        content={hvacInstallationProcessContent?.data}
        hasLightBackground
      />
    )
  }
  {isHvacInstallationService && <ServiceTrustSection />}
  {
    isHvacInstallationService && (
      <TestimonialQuoteSection hasSectionSpacing={false} />
    )
  }
  <FaqSection content={activeFaqContent?.data} hasLightBackground />
  <ServiceAreaSection hasSectionSpacing={false} />
  {
    isHeatingRepairService && (
      <CallToAction
        content={heatingRepairFinalCtaContent?.data}
        hasSectionSpacing={false}
      />
    )
  }
  {
    isHvacInstallationService && (
      <CallToAction
        content={hvacInstallationFinalCtaContent?.data}
        hasSectionSpacing={false}
      />
    )
  }
</Base>
